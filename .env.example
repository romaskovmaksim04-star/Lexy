# Local SQLite file (relative to prisma/)
DATABASE_URL="file:./dev.db"
# Long random string that signs login sessions: openssl rand -hex 32
AUTH_SECRET=""
# Public address of the site (links in payments and notifications)
SITE_URL="http://localhost:3000"

# Optional: speech service (ai/server.py): Whisper STT and TTS voices.
# Without it speaking uses the browser's speech recognition and listening uses the browser voice.
AI_URL="http://127.0.0.1:8765"
LEXY_AI_KEY=""

# Optional: LLM for Lexi calls, feedback and the examiner (polza.ai, OpenAI-compatible)
POLZA_API_KEY=""
# POLZA_URL="https://api.polza.ai/api/v1"
# LLM_MODEL="deepseek/deepseek-v4.1-flash"

# 1 = every account gets full access (beta), 0 = plans and limits apply
LEXY_OPEN_BETA="1"

# Optional: payments (Platega)
PLATEGA_BASE_URL="https://app.platega.io"
PLATEGA_MERCHANT_ID=""
PLATEGA_SECRET=""
# Protects /api/orders/sweep (called by a timer to settle pending payments)
CRON_SECRET=""

# Optional: Telegram notifications to the owners (new payments, bug reports)
TG_NOTIFY_TOKEN=""
TG_NOTIFY_CHATS=""
